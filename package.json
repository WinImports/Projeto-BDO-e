{
  "name": "bdo-e-app",
  "version": "2.0.0",
  "description": "BDO-e & Inspeção Técnica — Boletim Diário de Operações Eletrônico (desktop, offline-first)",
  "main": "main.js",
  "author": "WIN IMPORTS",
  "private": true,
  "scripts": {
    "start": "electron .",
    "electron:start": "electron .",
    "electron:build": "electron-builder --win nsis",
    "build": "node scripts/build-web.js",
    "test": "playwright test",
    "pocos": "node scripts/gerar-pocos.js",
    "postinstall": "node scripts/postinstall.js",
    "vendor": "node -e \"const f=require('fs');f.copyFileSync('node_modules/@supabase/supabase-js/dist/umd/supabase.js','src/vendor/supabase.js');f.copyFileSync('node_modules/jspdf/dist/jspdf.umd.min.js','src/vendor/jspdf.umd.min.js');f.copyFileSync('node_modules/jspdf-autotable/dist/jspdf.plugin.autotable.min.js','src/vendor/jspdf.plugin.autotable.min.js')\"",
    "pwa": "node scripts/gerar-pwa.js && npm test",
    "pwa:sw": "node scripts/gerar-pwa.js",
    "prepare": "git config core.hooksPath .githooks || echo \"(sem git: hooks não configurados)\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3"
  },
  "engines": {
    "node": ">=20"
  },
  "build": {
    "appId": "br.com.winappdigital.bdoe",
    "productName": "BDO-e",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release",
      "buildResources": "icons"
    },
    "files": [
      "package.json",
      "main.js",
      "preload.js",
      "electron/**",
      "index.html",
      "manifest.json",
      "icons/**",
      "src/**",
      "!tests/**",
      "!_legado/**",
      "!licencas/**",
      "!node_modules/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "icons/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BDO-e",
      "artifactName": "BDO-e-Setup-${version}.${ext}"
    }
  }
}
