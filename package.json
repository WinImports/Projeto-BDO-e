{
  "name": "bdo-e-app",
  "version": "2.0.0",
  "description": "BDO-e & Inspeção Técnica — Boletim Diário de Operações Eletrônico (desktop, offline-first)",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "playwright test",
    "pocos": "node scripts/gerar-pocos.js",
    "postinstall": "node node_modules/electron/install.js",
    "vendor": "node -e \"const f=require('fs');f.copyFileSync('node_modules/@supabase/supabase-js/dist/umd/supabase.js','src/vendor/supabase.js');f.copyFileSync('node_modules/jspdf/dist/jspdf.umd.min.js','src/vendor/jspdf.umd.min.js');f.copyFileSync('node_modules/jspdf-autotable/dist/jspdf.plugin.autotable.min.js','src/vendor/jspdf.plugin.autotable.min.js')\"",
    "pwa": "node scripts/gerar-pwa.js && npm test",
    "pwa:sw": "node scripts/gerar-pwa.js",
    "prepare": "git config core.hooksPath .githooks || echo \"(sem git: hooks não configurados)\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "electron": "^44.7.2"
  }
}
